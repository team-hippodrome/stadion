# build output
/build/
/build_asan/
/stadion.app/

# game data: never commit ROMs, saves or recordings of the games
*.z64
*.n64
*.v64
*.gb
*.gbc
/saves/
/gb/*.sav
/gb/base/
/gb/*.wav

.DS_Store
__pycache__/
*.pyc
build_android/
/build_web/
# the web deployment's private settings (tools/deploy_web.sh)
/deploy.local.env
/build-win-llvm/*

# Game screenshots are generated locally and never committed
tools/save_editor/verify/shots/
evidence/**/*.png
evidence/**/*.jpg
# your own ROM text, written by tools/text/extract_text.py: never commit it (ROM text rule)
/translation/rom-text/
# PokeAPI name tables, fetched by tools/text/check_names.py --download
/translation/pokeapi/
