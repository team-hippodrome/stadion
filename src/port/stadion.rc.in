// Windows resources of stadion.exe (configured by CMakeLists.txt): the icon Explorer and the taskbar show, and the
// version information of the file's Properties dialog
#include <winver.h>

1 ICON "@PORT_ICON@"
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/src/port/stadion.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PORT_VERSION_RC@
PRODUCTVERSION @PORT_VERSION_RC@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "team-hippodrome"
      VALUE "FileDescription", "stadion"
      VALUE "FileVersion", "@PORT_VERSION@"
      VALUE "InternalName", "stadion"
      VALUE "OriginalFilename", "stadion.exe"
      VALUE "ProductName", "stadion"
      VALUE "ProductVersion", "@PORT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
