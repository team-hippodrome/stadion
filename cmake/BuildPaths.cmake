# Compiler source locations and debug information are shipped in binaries and crash logs.
# Apply these mappings to all targets in this directory, including fetched dependencies.
set(PORT_PATH_MAP "" CACHE STRING "Additional path prefixes to rewrite: <old>=<new>;...")
set(_port_path_maps "")
foreach(_port_home_var HOME USERPROFILE)
  if(DEFINED ENV{${_port_home_var}} AND NOT "$ENV{${_port_home_var}}" STREQUAL "")
    file(TO_CMAKE_PATH "$ENV{${_port_home_var}}" _port_home)
    list(APPEND _port_path_maps "${_port_home}=~")
  endif()
endforeach()
# Specific prefixes follow home-directory mappings; clang uses the last matching mapping.
list(APPEND _port_path_maps "${CMAKE_BINARY_DIR}=build" "${CMAKE_SOURCE_DIR}=."
                           "${CMAKE_SOURCE_DIR}/=")
list(APPEND _port_path_maps ${PORT_PATH_MAP})
foreach(_port_map IN LISTS _port_path_maps)
  if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX,OBJCXX,ASM>:/clang:-ffile-prefix-map=${_port_map}>")
  else()
    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX,OBJCXX,ASM>:-ffile-prefix-map=${_port_map}>")
  endif()
endforeach()
# Mach-O debug maps are generated by the linker, outside the compiler's prefix mappings.
if(APPLE)
  add_link_options("LINKER:-oso_prefix,${CMAKE_BINARY_DIR}/")
endif()
