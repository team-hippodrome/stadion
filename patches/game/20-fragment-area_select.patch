+static u8* AreaSelect_DetileBackground(const u8* tiled) {
+    u8* linear = main_pool_alloc(320 * 240 * 2, 0);
+    if (linear == NULL) return NULL;
+
+    for (s32 tileY = 0; tileY < 15; ++tileY) {
+        for (s32 tileX = 0; tileX < 20; ++tileX) {
+            for (s32 row = 0; row < 16; ++row) {
+                u8* dst = linear + ((tileY * 16 + row) * 320 + tileX * 16) * 2;
+                _bcopy(tiled + row * 32, dst, 32);
+            }
+            tiled += 512;
+        }
+    }
+    return linear;
+}
