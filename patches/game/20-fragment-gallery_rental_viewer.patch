diff --git a/src/fragments/gallery_rental_viewer/gallery_rental_viewer.h b/src/fragments/gallery_rental_viewer/gallery_rental_viewer.h
index 9772b1412a879225caa8e804f28759d0b80c2fc1..6bfe8c9fe4a03b9f5cd29091cf695aa1a16bfa43 100644
--- a/src/fragments/gallery_rental_viewer/gallery_rental_viewer.h
+++ b/src/fragments/gallery_rental_viewer/gallery_rental_viewer.h
@@ -15,11 +15,22 @@ typedef struct unk_D_8380565C {
 
 typedef struct unk_D_838067F0_0168_0000 {
     union {
+        // PORT: raw is used as the big-endian word unk_000..unk_003 (bit 31 = unk_000's top bit, a "slot being
+        // replaced" flag; raw & 7 = the low bits of unk_003, the species). On a little-endian host the bytes are
+        // declared in reverse so raw keeps those values; before, the flag tests hit the species byte, so a Pokémon
+        // with species >= 128 (Mew) was never "already chosen" and could be picked twice.
         struct {
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+            u8 unk_003;
+            u8 unk_002;
+            u8 unk_001;
+            u8 unk_000;
+#else
             /* 0x000 */ u8 unk_000;
             /* 0x001 */ u8 unk_001;
             /* 0x002 */ u8 unk_002;
             /* 0x003 */ u8 unk_003;
+#endif
         };
         s32 raw;
     };
diff --git a/src/fragments/gallery_rental_viewer/gallery_rental_viewer_2AD910.c b/src/fragments/gallery_rental_viewer/gallery_rental_viewer_2AD910.c
index ee8b3a08c41bca6f9e1126fcf9d0b26f3a09dd05..ba2713a15b061d3438b6b595b5986185f39d9226 100644
--- a/src/fragments/gallery_rental_viewer/gallery_rental_viewer_2AD910.c
+++ b/src/fragments/gallery_rental_viewer/gallery_rental_viewer_2AD910.c
@@ -264,6 +264,20 @@ s32 Gallery_RentalViewerMain(s32 arg0, s32 arg1) {
 
     D_83805658 = BinArchive_GetFile(ASSET_LOAD2(backgrounds, 1, 1), 0x14);
     D_8380565C = BinArchive_GetFile(BinArchive_Open(TRAINER_DATA_ROM_START, NULL, 1, 0), 0x1A);
+    // PORT: the rental roster is big-endian ROM data (count, then BattleMon records), swapped in place once as in
+    // fragment61's Rental_LoadRoster. Unswapped, the count read as a huge number and the records' 16/32-bit fields
+    // (stats, experience) were byte-swapped. The archive may hand out the same buffer again: the count tells.
+    if ((D_8380565C != NULL) && (D_8380565C->unk_000 > 0x1000)) {
+        extern void Port_BattleMonFromBE(BattleMon * dst, const BattleMon* src);
+        u32 n = Port_Swap32(D_8380565C->unk_000);
+        u32 k;
+
+        D_8380565C->unk_000 = n;
+        for (k = 0; k < n; k++) {
+            BattleMon tmp = D_8380565C->unk_004[k];
+            Port_BattleMonFromBE(&D_8380565C->unk_004[k], &tmp);
+        }
+    }
 
     PokeIcon_OpenModelArchive();
     Gallery_RentalViewerInit(arg0);
