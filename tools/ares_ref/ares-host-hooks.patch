diff --git a/ares/n64/cpu/cpu.hpp b/ares/n64/cpu/cpu.hpp
index b51000d99..11fb06c96 100644
--- a/ares/n64/cpu/cpu.hpp
+++ b/ares/n64/cpu/cpu.hpp
@@ -49,6 +49,18 @@ struct CPU : Thread {
   auto queueInsert(u32 event, u32 clocks) -> void;
 
   auto instruction() -> bool;
+
+  //host hooks (pokestadium-port tools/ares_ref): when the CPU is about to execute a block or instruction at one of
+  //these virtual addresses (low 32 bits), callback(address) runs first; it returns true when it moved the PC (for
+  //example to return from a replaced function), so the original code there is not executed. Each hooked address
+  //also ends recompiler blocks like a breakpoint. Reset the recompiler after changing the list.
+  struct HostHooks {
+    std::vector<u32> addresses;  //sorted
+    std::function<bool (u32)> callback;
+    auto contains(u32 address) const -> bool {
+      return !addresses.empty() && std::binary_search(addresses.begin(), addresses.end(), address);
+    }
+  } hostHooks;
   auto instructionPrologue(u64 address, u32 instruction) -> void;
   template<bool Recompiled> auto instructionEpilogue() -> void;
   auto raiseCoprocessor1Exception() -> void;
